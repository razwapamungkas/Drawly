{
  "name": "drawly-workspace",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd drawly-backend && npm run start:dev",
    "dev:frontend": "cd drawly-frontend && pnpm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd drawly-backend && npm run build",
    "build:frontend": "cd drawly-frontend && pnpm run build"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
